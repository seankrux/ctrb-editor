# CTRBooster Nebula environment contract
#
# Production runtime:
# - No required environment variables at this time.
#
# Optional deployment/runtime knobs:
# NEXTJS_BASE_PATH=
# NEXT_PUBLIC_SITE_URL=
# NEXT_PUBLIC_API_BASE_URL=
# PREVIEW_API_STUBS=
# API_SERVICE_TOKEN=
# OPENAI_API_KEY=
#
# Optional local/test knobs:
# CI=1
# PORT=3000
# HOSTNAME=127.0.0.1
